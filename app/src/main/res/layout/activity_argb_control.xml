<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="2dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/audioBtn"
            android:layout_width="52dp"
            android:layout_height="44dp"
            android:text="A"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="#1565C0"
            android:textColor="#FFFFFF"
            android:minWidth="52dp"
            android:minHeight="44dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Rozlaczono"
            android:textColor="#FF5252"
            android:textSize="12sp"
            android:gravity="center"
            android:textStyle="bold" />

        <Button
            android:id="@+id/connectBtn"
            android:layout_width="70dp"
            android:layout_height="36dp"
            android:text="POLACZ"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="#4CAF50"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Three Section Panels -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">

        <!-- ZEWN Panel -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#111111"
            android:padding="2dp"
            android:layout_marginEnd="1dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ZEWN"
                android:textColor="#00BCD4"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- Effects ScrollView -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/extEffectsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </ScrollView>

            <!-- Brightness -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="JASN" android:textColor="#00BCD4" android:textSize="9sp"/>
            <SeekBar android:id="@+id/extBrightness"
                android:layout_width="match_parent" android:layout_height="30dp"
                android:max="255" android:progress="200"
                android:progressTint="#00BCD4" android:thumbTint="#00BCD4"/>

            <!-- Speed -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="PRED" android:textColor="#00BCD4" android:textSize="9sp"/>
            <SeekBar android:id="@+id/extSpeed"
                android:layout_width="match_parent" android:layout_height="30dp"
                android:max="9" android:progress="5"
                android:progressTint="#00BCD4" android:thumbTint="#00BCD4"/>

            <!-- Colors -->
            <LinearLayout
                android:id="@+id/extColorsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- WEWN Panel -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#111111"
            android:padding="2dp"
            android:layout_marginEnd="1dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="WEWN"
                android:textColor="#E040FB"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- Effects ScrollView -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/intEffectsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </ScrollView>

            <!-- Brightness -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="JASN" android:textColor="#E040FB" android:textSize="9sp"/>
            <SeekBar android:id="@+id/intBrightness"
                android:layout_width="match_parent" android:layout_height="30dp"
                android:max="255" android:progress="200"
                android:progressTint="#E040FB" android:thumbTint="#E040FB"/>

            <!-- Speed -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="PRED" android:textColor="#E040FB" android:textSize="9sp"/>
            <SeekBar android:id="@+id/intSpeed"
                android:layout_width="match_parent" android:layout_height="30dp"
                android:max="9" android:progress="5"
                android:progressTint="#E040FB" android:thumbTint="#E040FB"/>

            <!-- Colors -->
            <LinearLayout
                android:id="@+id/intColorsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- FAN Panel -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#111111"
            android:padding="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FAN"
                android:textColor="#FF9800"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- Effects ScrollView -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/fanEffectsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </ScrollView>

            <!-- Brightness -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="JASN" android:textColor="#FF9800" android:textSize="9sp"/>
            <SeekBar android:id="@+id/fanBrightness"
                android:layout_width="match_parent" android:layout_height="30dp"
                android:max="255" android:progress="200"
                android:progressTint="#FF9800" android:thumbTint="#FF9800"/>

            <!-- Speed -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="PRED" android:textColor="#FF9800" android:textSize="9sp"/>
            <SeekBar android:id="@+id/fanSpeed"
                android:layout_width="match_parent" android:layout_height="30dp"
                android:max="9" android:progress="5"
                android:progressTint="#FF9800" android:thumbTint="#FF9800"/>

            <!-- Colors -->
            <LinearLayout
                android:id="@+id/fanColorsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Fan PWM Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="PWM:"
                android:textColor="#FF9800"
                android:textSize="9sp"
                android:gravity="center_vertical"
                android:layout_marginEnd="2dp"/>

            <Button android:id="@+id/fanSilent" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="match_parent" android:text="CICHY" android:textSize="10sp"
                android:background="#333333" android:textColor="#FF9800" android:layout_marginEnd="1dp"/>
            <Button android:id="@+id/fanNormal" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="match_parent" android:text="NORM" android:textSize="10sp"
                android:background="#333333" android:textColor="#FF9800" android:layout_marginEnd="1dp"/>
            <Button android:id="@+id/fanMax" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="match_parent" android:text="MAX" android:textSize="10sp"
                android:background="#333333" android:textColor="#FF9800" android:layout_marginEnd="1dp"/>
            <Button android:id="@+id/fanManual" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="match_parent" android:text="RECZNY" android:textSize="10sp"
                android:background="#333333" android:textColor="#FF9800"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/fanManualContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:layout_marginTop="2dp">
            <SeekBar android:id="@+id/fanSpeedSeekBar"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:max="100" android:progress="50" android:progressTint="#FF9800" android:thumbTint="#FF9800"/>
            <TextView android:id="@+id/fanSpeedText"
                android:layout_width="36dp" android:layout_height="wrap_content"
                android:text="50%" android:textColor="#FF9800" android:textSize="10sp" android:gravity="end"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
